{
  "name": "dsh-endfield-startup",
  "version": "4.1.0",
  "private": true,
  "type": "module",
  "description": "终末地工业风格的 DeepSeek Harness 启动序列：中央 Logo 扫光进入并飞入角落、炭黑/信号黄/全直角、中英双语、Edge Aria 女声、环形链路 HUD、编号步骤轨、系统读数与模块加载条，以及 6 秒二次确认倒计时、每秒自动扫描权限的授权硬门控。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "startup",
    "splash",
    "endfield"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "main": "lib/index.js",
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
